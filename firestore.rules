rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users: anyone can read; each user only writes their own document.
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId;
    }

    // Follows: anyone can read; you can only create follows where you are the follower.
    match /follows/{followId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.followerId == request.auth.uid;
    }

    // Tweets: anyone can read; you can only publish tweets under your own name.
    match /tweets/{tweetId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid;
    }
  }
}